<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Ocular-Core Lite — Edge AI Iris Generation</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@200;300;400;500;600;700;900&family=JetBrains+Mono:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet"/>
<style>
:root {
  --bg: #f8f6f1;
  --bg2: #f0ede5;
  --ink: #111010;
  --ink2: #2a2826;
  --muted: #8c8780;
  --border: #ddd9d0;
  --border2: #c8c3b8;
  --gold: #b8860b;
  --gold-light: #d4a017;
  --gold-pale: #f5ecd4;
  --teal: #1a6b6b;
  --teal-light: #2a9090;
  --card: #faf8f4;
  --tag: #ebe7de;
}
*, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
html { scroll-behavior: smooth; }
body {
  background: var(--bg);
  color: var(--ink);
  font-family: 'Outfit', sans-serif;
  overflow-x: hidden;
}
body::before {
  content:'';
  position:fixed; inset:0;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='g'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23g)' opacity='0.03'/%3E%3C/svg%3E");
  pointer-events:none; z-index:0; opacity:0.6;
}
nav {
  position:sticky; top:0; z-index:200;
  display:flex; align-items:center; justify-content:space-between;
  padding:1rem 4rem;
  background:rgba(248,246,241,0.93);
  backdrop-filter:blur(14px);
  border-bottom:1px solid var(--border);
}
.nav-wordmark { font-size:0.95rem; font-weight:700; letter-spacing:0.06em; }
.nav-wordmark sup {
  font-size:0.5rem; font-family:'JetBrains Mono',monospace; font-weight:400;
  color:var(--muted); letter-spacing:0.1em; text-transform:uppercase;
  vertical-align:super; margin-left:0.3rem;
}
.nav-links { display:flex; gap:2.5rem; list-style:none; align-items:center; }
.nav-links a {
  font-family:'JetBrains Mono',monospace; font-size:0.68rem;
  letter-spacing:0.1em; text-transform:uppercase; color:var(--muted);
  text-decoration:none; transition:color 0.2s;
}
.nav-links a:hover { color:var(--ink); }
.nav-pill {
  font-family:'JetBrains Mono',monospace; font-size:0.58rem;
  letter-spacing:0.1em; text-transform:uppercase;
  background:var(--gold-pale); border:1px solid var(--gold-light);
  color:var(--gold); padding:0.3rem 0.8rem; border-radius:99px;
}
.hero {
  min-height:95vh; display:grid; grid-template-columns:1fr 1fr;
  position:relative; z-index:1; border-bottom:1px solid var(--border);
}
.hero-left {
  padding:7rem 4rem 5rem; display:flex; flex-direction:column;
  justify-content:center; border-right:1px solid var(--border);
}
.hero-kicker {
  display:flex; align-items:center; gap:0.8rem;
  font-family:'JetBrains Mono',monospace; font-size:0.62rem;
  letter-spacing:0.2em; text-transform:uppercase; color:var(--teal);
  margin-bottom:2.5rem;
}
.kicker-dot {
  width:6px; height:6px; border-radius:50%; background:var(--teal);
  animation:blink 2s ease-in-out infinite;
}
@keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.2} }
h1 {
  font-size:clamp(3.5rem,5.5vw,6.5rem); font-weight:900;
  line-height:0.92; letter-spacing:-0.03em; margin-bottom:2.5rem;
}
h1 .gold { color:var(--gold); }
h1 .thin { font-weight:200; color:var(--muted); }
.hero-desc {
  font-family:'JetBrains Mono',monospace; font-size:0.78rem;
  line-height:2; color:var(--muted); max-width:46ch; margin-bottom:3rem;
}
.hero-desc b { color:var(--ink); font-weight:500; }
.hero-actions { display:flex; gap:1rem; flex-wrap:wrap; }
.btn-solid {
  font-family:'Outfit',sans-serif; font-weight:600; font-size:0.82rem;
  letter-spacing:0.04em; padding:0.85rem 2rem; background:var(--ink);
  color:var(--bg); border:none; border-radius:4px; text-decoration:none;
  display:inline-block; transition:background 0.2s,transform 0.15s;
}
.btn-solid:hover { background:var(--ink2); transform:translateY(-2px); }
.btn-outline {
  font-family:'JetBrains Mono',monospace; font-size:0.68rem;
  letter-spacing:0.1em; text-transform:uppercase; padding:0.85rem 1.6rem;
  background:transparent; color:var(--ink2); border:1px solid var(--border2);
  border-radius:4px; text-decoration:none; display:inline-block; transition:all 0.2s;
}
.btn-outline:hover { border-color:var(--ink); color:var(--ink); }
.hero-right { display:grid; grid-template-rows:1fr 1fr; overflow:hidden; }
.hero-img-top { position:relative; overflow:hidden; border-bottom:1px solid var(--border); }
.hero-img-top img { width:100%; height:100%; object-fit:cover; object-position:center; filter:saturate(1.1) contrast(1.05); transition:transform 6s ease; }
.hero-img-top:hover img { transform:scale(1.03); }
.hero-img-bottom { display:grid; grid-template-columns:1fr 1fr; }
.hero-img-sm { position:relative; overflow:hidden; }
.hero-img-sm:first-child { border-right:1px solid var(--border); }
.hero-img-sm img { width:100%; height:100%; object-fit:cover; object-position:center; transition:transform 5s ease; }
.hero-img-sm:hover img { transform:scale(1.04); }
.img-caption {
  position:absolute; bottom:0.7rem; left:0.8rem;
  font-family:'JetBrains Mono',monospace; font-size:0.55rem;
  letter-spacing:0.1em; text-transform:uppercase;
  color:rgba(255,255,255,0.85); background:rgba(0,0,0,0.45);
  backdrop-filter:blur(4px); padding:0.2rem 0.5rem; border-radius:2px;
}
.stats-row {
  display:grid; grid-template-columns:repeat(4,1fr);
  border-bottom:1px solid var(--border); position:relative; z-index:1;
}
.stat-block {
  padding:2.2rem 2.8rem; border-right:1px solid var(--border);
  position:relative; overflow:hidden;
}
.stat-block:last-child { border-right:none; }
.stat-block::after {
  content:''; position:absolute; bottom:0; left:0; right:0; height:2px;
  background:linear-gradient(90deg,var(--gold-light),var(--teal-light));
  transform:scaleX(0); transform-origin:left; transition:transform 0.4s;
}
.stat-block:hover::after { transform:scaleX(1); }
.stat-n { font-size:3rem; font-weight:900; line-height:1; letter-spacing:-0.04em; color:var(--ink); margin-bottom:0.4rem; }
.stat-n .u { font-size:1.1rem; font-weight:300; color:var(--muted); }
.stat-lbl { font-family:'JetBrains Mono',monospace; font-size:0.6rem; letter-spacing:0.12em; text-transform:uppercase; color:var(--muted); }
.sec { padding:6rem 4rem; position:relative; z-index:1; }
.sec+.sec { border-top:1px solid var(--border); }
.sec-eyebrow { font-family:'JetBrains Mono',monospace; font-size:0.6rem; letter-spacing:0.22em; text-transform:uppercase; color:var(--teal); margin-bottom:0.7rem; }
.sec-heading { font-size:clamp(2rem,3.5vw,3rem); font-weight:800; letter-spacing:-0.025em; line-height:1.1; color:var(--ink); margin-bottom:3.5rem; }
.gallery-full {
  display:grid; grid-template-columns:2fr 1fr 1fr; grid-template-rows:auto auto;
  gap:1px; background:var(--border); border:1px solid var(--border);
  border-radius:8px; overflow:hidden; margin-bottom:1.5rem;
}
.gal-card { background:var(--bg2); position:relative; overflow:hidden; }
.gal-card img { width:100%; height:100%; object-fit:cover; object-position:center; display:block; transition:transform 5s ease; }
.gal-card:hover img { transform:scale(1.04); }
.gal-card-tall { grid-row:span 2; }
.gal-caption {
  position:absolute; bottom:0; left:0; right:0;
  padding:2rem 1.5rem 1.2rem;
  background:linear-gradient(transparent,rgba(0,0,0,0.62));
}
.gal-cap-tag { font-family:'JetBrains Mono',monospace; font-size:0.55rem; letter-spacing:0.15em; text-transform:uppercase; color:rgba(255,255,255,0.6); margin-bottom:0.3rem; }
.gal-cap-title { font-size:0.82rem; font-weight:600; color:white; margin-bottom:0.2rem; }
.gal-cap-prompt { font-family:'JetBrains Mono',monospace; font-size:0.6rem; color:rgba(255,255,255,0.5); font-style:italic; }
.arch-layout { display:grid; grid-template-columns:1fr 1fr; gap:3rem; align-items:start; }
.arch-cards { display:grid; grid-template-columns:1fr 1fr; gap:1px; background:var(--border); border:1px solid var(--border); border-radius:8px; overflow:hidden; }
.arch-card { background:var(--card); padding:1.8rem; transition:background 0.2s; }
.arch-card:hover { background:var(--gold-pale); }
.arch-card-num { font-family:'JetBrains Mono',monospace; font-size:0.55rem; letter-spacing:0.15em; color:var(--border2); margin-bottom:1rem; text-transform:uppercase; }
.arch-card-icon { font-size:1.6rem; margin-bottom:0.7rem; display:block; }
.arch-card-name { font-size:0.92rem; font-weight:700; color:var(--ink); margin-bottom:0.25rem; }
.arch-card-tech { font-family:'JetBrains Mono',monospace; font-size:0.6rem; color:var(--teal); margin-bottom:0.7rem; letter-spacing:0.05em; }
.arch-card-desc { font-family:'JetBrains Mono',monospace; font-size:0.67rem; line-height:1.85; color:var(--muted); }
.pipeline { display:flex; flex-direction:column; gap:0; }
.pipe-step { display:grid; grid-template-columns:3rem 1px 1fr; gap:0 1.5rem; position:relative; }
.pipe-num { font-family:'JetBrains Mono',monospace; font-size:0.6rem; color:var(--muted); padding-top:0.2rem; text-align:right; }
.pipe-line { width:1px; background:var(--border2); position:relative; }
.pipe-line::before { content:''; position:absolute; top:0.6rem; left:50%; transform:translateX(-50%); width:8px; height:8px; border-radius:50%; background:var(--gold-light); border:2px solid var(--bg); }
.pipe-body { padding:0 0 2rem 0; }
.pipe-title { font-size:0.9rem; font-weight:700; color:var(--ink); margin-bottom:0.25rem; padding-top:0.1rem; }
.pipe-sub { font-family:'JetBrains Mono',monospace; font-size:0.65rem; color:var(--muted); line-height:1.7; }
.code-wrap { background:var(--ink); border-radius:8px; overflow:hidden; font-family:'JetBrains Mono',monospace; font-size:0.72rem; line-height:1.9; }
.code-head { display:flex; align-items:center; justify-content:space-between; padding:0.75rem 1.2rem; background:rgba(255,255,255,0.04); border-bottom:1px solid rgba(255,255,255,0.08); }
.code-dots { display:flex; gap:0.35rem; }
.cd { width:10px; height:10px; border-radius:50%; }
.cd-r { background:#ff5f57; } .cd-y { background:#febc2e; } .cd-g { background:#28c840; }
.code-fname { font-size:0.6rem; letter-spacing:0.08em; color:rgba(255,255,255,0.3); }
.code-body { padding:1.5rem; color:#8a9ab5; overflow-x:auto; }
.code-body .c { color:#3d5070; }
.code-body .k { color:#d4a017; }
.code-body .s { color:#7db87d; }
.code-body .fn { color:#6ab0d4; }
.code-body .t { color:#c8a0e0; }
.code-body .w { color:#e8e8e8; }
.specs-section { background:var(--bg2); }
.specs-two-col { display:grid; grid-template-columns:1fr 1fr; gap:3rem; }
.spec-group-label { font-family:'JetBrains Mono',monospace; font-size:0.6rem; letter-spacing:0.2em; text-transform:uppercase; color:var(--teal); margin-bottom:1rem; padding-bottom:0.6rem; border-bottom:1px solid var(--border); }
.spec-row { display:flex; justify-content:space-between; align-items:center; padding:0.7rem 0; border-bottom:1px solid var(--border); font-family:'JetBrains Mono',monospace; font-size:0.7rem; }
.spec-k { color:var(--muted); }
.spec-v { color:var(--ink); }
.spec-v.hi { color:var(--teal); font-weight:500; }
.spec-v.gold { color:var(--gold); font-weight:500; }
.hw-band { background:var(--card); border:1px solid var(--border); border-radius:8px; padding:1.8rem 2rem; display:flex; align-items:center; gap:2rem; margin-bottom:3rem; }
.hw-icon { font-size:2rem; flex-shrink:0; }
.hw-label { font-family:'JetBrains Mono',monospace; font-size:0.58rem; letter-spacing:0.15em; text-transform:uppercase; color:var(--teal); margin-bottom:0.3rem; }
.hw-name { font-size:1rem; font-weight:700; color:var(--ink); margin-bottom:0.2rem; }
.hw-detail { font-family:'JetBrains Mono',monospace; font-size:0.65rem; color:var(--muted); }
.hw-badge { margin-left:auto; flex-shrink:0; font-family:'JetBrains Mono',monospace; font-size:0.58rem; letter-spacing:0.08em; background:var(--gold-pale); border:1px solid var(--gold-light); color:var(--gold); padding:0.5rem 1rem; border-radius:4px; text-align:center; line-height:1.6; }
.install-grid { display:grid; grid-template-columns:1fr 1.2fr; gap:3rem; align-items:start; }
.step-list { list-style:none; }
.step-item { display:flex; gap:1.2rem; align-items:flex-start; margin-bottom:2rem; }
.step-n { font-family:'JetBrains Mono',monospace; font-size:0.6rem; color:var(--gold-light); width:1.5rem; flex-shrink:0; padding-top:0.15rem; }
.step-title { font-size:0.9rem; font-weight:700; color:var(--ink); margin-bottom:0.3rem; }
.step-desc { font-family:'JetBrains Mono',monospace; font-size:0.68rem; line-height:1.8; color:var(--muted); }
.cta-band {
  background:var(--ink); color:var(--bg); border-radius:10px; padding:3.5rem 4rem;
  display:grid; grid-template-columns:1fr auto; gap:2rem; align-items:center;
  position:relative; z-index:1; overflow:hidden; margin:0 4rem 5rem;
}
.cta-band::before { content:''; position:absolute; top:-60px; right:-60px; width:300px; height:300px; border-radius:50%; background:radial-gradient(circle,rgba(212,160,23,0.12),transparent 70%); }
.cta-tag { font-family:'JetBrains Mono',monospace; font-size:0.6rem; letter-spacing:0.2em; text-transform:uppercase; color:var(--gold-light); margin-bottom:0.6rem; }
.cta-h { font-size:2rem; font-weight:900; letter-spacing:-0.025em; margin-bottom:0.5rem; }
.cta-p { font-family:'JetBrains Mono',monospace; font-size:0.72rem; color:rgba(248,246,241,0.5); line-height:1.8; max-width:52ch; }
.cta-btns { display:flex; flex-direction:column; gap:0.7rem; align-items:flex-end; }
.btn-gold { font-family:'Outfit',sans-serif; font-weight:700; font-size:0.82rem; padding:0.85rem 2rem; background:var(--gold-light); color:var(--ink); border:none; border-radius:4px; text-decoration:none; display:inline-block; transition:background 0.2s,transform 0.15s; white-space:nowrap; }
.btn-gold:hover { background:var(--gold); transform:translateY(-2px); }
.btn-ghost { font-family:'JetBrains Mono',monospace; font-size:0.65rem; letter-spacing:0.1em; text-transform:uppercase; padding:0.6rem 1.2rem; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.15); color:rgba(248,246,241,0.7); border-radius:4px; text-decoration:none; display:inline-block; transition:all 0.2s; white-space:nowrap; }
.btn-ghost:hover { background:rgba(255,255,255,0.1); color:var(--bg); }
footer { border-top:1px solid var(--border); padding:2rem 4rem; display:flex; justify-content:space-between; align-items:center; position:relative; z-index:1; }
footer p { font-family:'JetBrains Mono',monospace; font-size:0.65rem; color:var(--muted); line-height:1.9; }
footer a { color:var(--teal); text-decoration:none; }
.foot-badges { display:flex; gap:0.5rem; flex-wrap:wrap; }
.fbadge { font-family:'JetBrains Mono',monospace; font-size:0.55rem; letter-spacing:0.08em; padding:0.2rem 0.55rem; border-radius:2px; border:1px solid; }
.fb-gold { border-color:var(--gold-light); color:var(--gold); background:var(--gold-pale); }
.fb-teal { border-color:var(--teal-light); color:var(--teal); background:rgba(26,107,107,0.06); }
.fb-ink { border-color:var(--border2); color:var(--muted); background:var(--tag); }
@media(max-width:900px){
  nav{padding:1rem 1.5rem;}
  .hero{grid-template-columns:1fr;}
  .hero-right{display:none;}
  .hero-left{padding:4rem 1.5rem 3rem;}
  .stats-row{grid-template-columns:1fr 1fr;}
  .stat-block:nth-child(2){border-right:none;}
  .stat-block:nth-child(3){border-right:1px solid var(--border);}
  .sec{padding:4rem 1.5rem;}
  .arch-layout,.install-grid,.specs-two-col{grid-template-columns:1fr;}
  .arch-cards{grid-template-columns:1fr;}
  .gallery-full{grid-template-columns:1fr;grid-template-rows:auto;}
  .gal-card-tall{grid-row:span 1;}
  .cta-band{margin:0 1.5rem 4rem;padding:2rem 1.5rem;grid-template-columns:1fr;}
  .cta-btns{align-items:flex-start;flex-direction:row;flex-wrap:wrap;}
  footer{padding:1.5rem;flex-direction:column;gap:1rem;}
}
</style>
</head>
